# Copy to conf/legacy-credentials to give every station installed without
# HERMES_HARDENING these fixed credentials instead of random ones: a
# deployment whose stations, operators and users' phones share them.  Keep
# the real file out of any public repository.
HERMES_DB_PASSWORD="change-me"
ROUNDCUBE_DB_PASSWORD="change-me"
ROUNDCUBE_DES_KEY="change-me-24-characters!"
MAIL_ROOT_PASSWORD="change-me"
HERMES_EMAILAPI_PASS="change-me"
VNC_PASSWORD="change-me"
PI_PASSWORD="change-me"
WIFI_PASSPHRASE="change-me"
