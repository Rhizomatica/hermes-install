time any

chat-timeout 600
call-login user
call-password pass
chat "" \r

port HFP

forward ANY
commands rmail crmail bash uucp sudo dec_sensors dec_message

protocol y
protocol-parameter y packet-size 512
protocol-parameter y timeout 5400

system CABB
alias gw

system CABB-1
alias station1

system CABB-2
alias station2

system CABB-3
alias center

