time any

chat-timeout 600
call-login user
call-password change-me
chat "" \r

port HFP

forward *
commands rmail crmail bash uucp sudo dec_sensors dec_message

protocol yiG
protocol-parameter y packet-size 512
protocol-parameter y timeout 5400

system hermes
alias gw
port TCP
protocol G
address 10.70.96.1
chat "" \d\d\r\c ogin: \d\L word: \P

system CABB
alias local

system CABB-1
alias station1

system CABB-2
alias station2

system CABB-3
alias center

