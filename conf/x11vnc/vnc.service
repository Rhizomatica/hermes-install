[Unit]
Description=vnc server
Requires=x11.service
After=x11.service

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/root
# localhost only: reach it through an SSH tunnel
#   ssh -L 5900:127.0.0.1:5900 pi@station
ExecStart=x11vnc -display WAIT:69 -forever -usepw -quiet -listen 127.0.0.1 -xkb -auth /root/.Xauthority
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target


